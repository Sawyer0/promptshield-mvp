{
  "name": "@dawans/promptshield",
  "version": "1.0.5",
  "publishConfig": {
    "access": "public"
  },
  "description": "Secure your LLM stack with enterprise-grade RulePacks for AI safety scanning",
  "author": "PromptShield Team",
  "license": "Apache-2.0",
  "keywords": [
    "llm",
    "security",
    "ai",
    "safety",
    "cli",
    "rulepack",
    "prompt-injection",
    "ai-safety",
    "security-scanning",
    "vulnerability-detection"
  ],
  "homepage": "https://x.com/Sawyer0",
  "bugs": {
    "url": "https://x.com/Sawyer0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "promptshield": "./bin/promptshield"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "build": "npm run clean && tsc",
    "start": "node bin/promptshield",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration tests/e2e",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests scripts",
    "lint:fix": "eslint src tests scripts --fix",
    "format": "prettier --write src tests scripts",
    "format:check": "prettier --check src tests scripts",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "deps:clean": "npm cache clean --force && node -e \"require('fs').rmSync('node_modules', {recursive: true, force: true})\" && npm install",
    "validate": "npm run type-check && npm run lint && npm run format:check && npm run security:audit",
    "prepublishOnly": "npm run type-check && npm run lint && npm run format:check && npm run security:audit",
    "ci": "npm run type-check && npm run lint && npm run format:check && npm test && npm run build",
    "prepare": "npm run build"
  },
  "files": [
    "bin",
    "dist",
    "rulepacks",
    "README.md",
    "docs/QUICKSTART.md",
    "docs/CLI_REFERENCE.md"
  ],
  "type": "commonjs",
  "devDependencies": {
    "@types/chalk": "^2.2.4",
    "@types/glob": "^8.1.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/stream-json": "^1.7.8",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "jest": "^29.4.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "chalk": "^4.1.2",
    "commander": "^14.0.0",
    "glob": "^11.0.3",
    "js-yaml": "^4.1.0",
    "stream-json": "^1.9.1",
    "zod": "^4.0.5"
  }
}
